# Required for Supabase-backed persistence.
# Prefer POSTGRES_URL because the app can auto-create the flow_state table.
POSTGRES_URL="postgres://USER:PASSWORD@HOST:6543/postgres?sslmode=require"

# Optional fallback if you do not expose a Postgres URL to the app server.
# If you use this REST path, run supabase/schema.sql first.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVER_ONLY_SERVICE_ROLE_KEY"
# or: SUPABASE_SECRET_KEY="YOUR_SERVER_ONLY_SECRET_KEY"

# Public browser-side Supabase keys are not used by this app right now.
# NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_PUBLIC_ANON_KEY"
